; Engine configuration file.
; Paciente Cero — Godot 4.3+

config_version=5

[application]

config/name="Paciente Cero"
config/description="Arcade casual cenital: contagiá humanos y hacé crecer tu horda."
config/version="0.2.0"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.976471, 0.964706, 0.94902, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
ActorAtlas="*res://scripts/autoload/actor_atlas.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.952941, 0.901961, 0.866667, 1)
